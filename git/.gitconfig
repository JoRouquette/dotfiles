; ============================================================
;  ~/.gitconfig — Git Configuration (dotfiles)
;
;  Convention :
;    - alias courts et one-liners : inline ci-dessous
;    - logique complexe           : script externe dans
;                                   ~/.config/git/bin/git-<nom>, référencé
;                                   par chemin absolu :
;                                   "!\"$HOME\"/.config/git/bin/git-<nom>"
;
;  Les alias référencent les scripts par chemin absolu $HOME : ils sont
;  donc trouvés SANS rien ajouter au PATH, dans n'importe quel shell
;  (PowerShell, cmd, bash). Détails dans CONTRIBUTING.md §5.
;
;  Le PATH et les shell functions ne servent QUE pour les `cd` worktree
;  (wgo, wsw, wnew, wadd, wroot), Bash-only. Pour en profiter sous bash :
;
;      source ~/.config/git/bashrc-git.sh
;
;  IDENTITÉ : configurer dans ~/.projects/dotfiles-config/gitconfig.local
;             ou ~/.gitconfig.local (voir README.md)
; ============================================================

[user]
	; Identité définie dans dotfiles-config ou ~/.gitconfig.local
	; name  = Prénom NOM
	; email = prenom.nom@example.com

[core]
	editor    = code --wait
	longpaths = true
	autocrlf  = input

[init]
	defaultBranch = main

[push]
	default        = current
	autoSetupRemote = true
	followTags     = true

[pull]
	rebase = true
	ff     = only

[fetch]
	prune     = true
	pruneTags = true

[rebase]
	autoStash   = true
	autoSquash  = true
	updateRefs  = true

[merge]
	conflictStyle = zdiff3

[diff]
	algorithm   = histogram
	colorMoved  = default
	mnemonicPrefix = true
	renames     = true

[color]
	ui = auto

[rerere]
	enabled = true

[help]
	autocorrect = prompt

[branch]
	sort = -committerdate

[tag]
	sort = -creatordate

[log]
	date = iso-local

[status]
	submoduleSummary = true
	showUntrackedFiles = all

; ============================================================
;                           ALIAS
; ============================================================

[alias]

	# --- Meta -------------------------------------------------
	cge = config --global --edit
	aliases = !git config --get-regexp '^alias\\.' | sed 's/alias\\.//' | sort

	# --- Basics -----------------------------------------------
	co  = checkout
	br  = branch
	st  = status
	nb  = checkout -b
	del = branch -D
	sb  = submodule
	sbf = "!f() { git submodule foreach \"$@\"; }; f"

	# --- Status & log ----------------------------------------
	state = !git fetch --prune --tags && clear && git branch -vv && git status
	logn  = !git log --oneline -n
	sl    = stash list --pretty='%C(yellow)%gd%Creset %s %Cgreen(%cr)%Creset'
	ll    = "!\"$HOME\"/.config/git/bin/git-ll"
	tree  = "!\"$HOME\"/.config/git/bin/git-tree"
	resume = "!\"$HOME\"/.config/git/bin/git-resume"
	resume-branch = "!\"$HOME\"/.config/git/bin/git-resume-branch"

	# --- Commit & push ---------------------------------------
	c     = "!\"$HOME\"/.config/git/bin/git-c"
	ce    = "!\"$HOME\"/.config/git/bin/git-ce"
	wip   = !git add --all && git commit -m 'chore: wip' && git p
	amend = !git add --all && git commit --amend --no-edit
	afp   = !git amend && git fp
	p     = !git push -u origin $(git rev-parse --abbrev-ref HEAD)
	fp    = !git push origin $(git rev-parse --abbrev-ref HEAD) --force-with-lease
	drop  = !git reset --hard HEAD && git clean -fd
	undo  = reset --soft HEAD~1
	cp    = "!\"$HOME\"/.config/git/bin/git-cp"

	# --- Branches --------------------------------------------
	iswitch       = "!\"$HOME\"/.config/git/bin/git-iswitch"
	rename-branch = "!\"$HOME\"/.config/git/bin/git-rename-branch"
	fetch-all     = "!\"$HOME\"/.config/git/bin/git-fetch-all"

	# --- Rebase ----------------------------------------------
	rom = !git fetch --all && git rebase $(git rev-parse --abbrev-ref origin/HEAD)
	rim = !git rebase -i $(git merge-base HEAD $(git symbolic-ref --short HEAD)@{upstream})
	rh  = !git fetch && git reset --hard origin/$(git rev-parse --abbrev-ref HEAD)
	ri  = "!f() { git rebase -i HEAD~$1; }; f"
	rc  = rebase --continue
	rs  = rebase --skip
	ra  = rebase --abort
	rebase-source = "!\"$HOME\"/.config/git/bin/git-rebase-source"

	# --- Cherry-pick -----------------------------------------
	cpick      = "!\"$HOME\"/.config/git/bin/git-cpick"
	cpick-move = "!\"$HOME\"/.config/git/bin/git-cpick-move"

	# --- WIP cleanup & sync ----------------------------------
	wip-fixup   = "!\"$HOME\"/.config/git/bin/git-wip-fixup"
	cleanup-all = "!\"$HOME\"/.config/git/bin/git-cleanup-all"
	cleanup     = "!\"$HOME\"/.config/git/bin/git-cleanup"
	update-repo = "!\"$HOME\"/.config/git/bin/git-update-repo"
	refresh     = "!\"$HOME\"/.config/git/bin/git-refresh"

	# --- Git-flow simulation ---------------------------------
	start = "!\"$HOME\"/.config/git/bin/git-start"

	# --- Pull Requests ---------------------------------------
	prdevops = "!\"$HOME\"/.config/git/bin/git-prdevops"
	prgithub = "!\"$HOME\"/.config/git/bin/git-prgithub"

	# --- Worktrees -------------------------------------------
	w    = !printf 'Worktree aliases:\n  wl   worktree list\n  wp   worktree prune\n  wa   add worktree from existing branch (local/remote)\n  wn   new branch + worktree from a base\n  ws   interactive switcher (prints path)\n  wg   jump to a worktree by branch name (prints path)\n  wst  status overview of all worktrees\n  wpl  pull (ff-only) all worktrees at once\n  wc   prune + remove merged worktrees\n  wr   remove a worktree interactively\n  clone-worktree   clone repo in bare mode + first worktree\n'
	wl   = worktree list
	wp   = worktree prune
	wa   = "!\"$HOME\"/.config/git/bin/git-wadd"       # add worktree from existing branch (local/remote)
	wn   = "!\"$HOME\"/.config/git/bin/git-wnew"       # new branch + worktree from a base
	ws   = "!\"$HOME\"/.config/git/bin/git-wswitch"    # interactive switcher (prints path)
	wg   = "!\"$HOME\"/.config/git/bin/git-wgo"        # jump to a worktree by branch name (prints path)
	wst  = "!\"$HOME\"/.config/git/bin/git-wstatus"    # status overview of all worktrees
	wpl  = "!\"$HOME\"/.config/git/bin/git-wpull"      # pull all worktrees (fetch + ff-only)
	wc   = "!\"$HOME\"/.config/git/bin/git-wclean"     # prune + remove merged worktrees
	wr   = "!\"$HOME\"/.config/git/bin/git-wremove"    # remove a worktree interactively
	clone-worktree = "!\"$HOME\"/.config/git/bin/git-clone-worktree"

	# --- Formatage (fichiers de git status, un par un) -------
	format     = "!\"$HOME\"/.config/git/bin/git-format"       # API (.cs) puis UI (.ts/.html/.scss/.json)
	format-api = "!\"$HOME\"/.config/git/bin/git-format-api"   # CSharpier sur les .cs de git status
	format-ui  = "!\"$HOME\"/.config/git/bin/git-format-ui"    # Prettier sur les .ts/.html/.scss/.json de git status

	# --- Dotnet / Entity Framework ---------------------------
	watch-run           = "!\"$HOME\"/.config/git/bin/git-watch-run"
	ef-list-migrations  = "!\"$HOME\"/.config/git/bin/git-ef-list-migrations"
	ef-revert           = "!\"$HOME\"/.config/git/bin/git-ef-revert"
	create-migration    = "!\"$HOME\"/.config/git/bin/git-create-migration"
	apply-migrations    = "!\"$HOME\"/.config/git/bin/git-apply-migrations"

	# --- Dotfiles sync ---------------------------------------
	dsync = "!\"$HOME\"/.config/git/bin/git-dsync"

	# --- Network & process (Windows / Git Bash) --------------
	netstat        = !netstat -ano | grep LISTEN
	kill-listening = "!\"$HOME\"/.config/git/bin/git-kill-listening"

[filter "lfs"]
	smudge   = git-lfs smudge -- %f
	process  = git-lfs filter-process
	required = true
	clean    = git-lfs clean -- %f

[remote "origin"]
	fetch = +refs/heads/*:refs/remotes/origin/*

; ============================================================
;  Personnalisation (ordre de priorité : le dernier gagne)
;
;  1. Config privée versionnée (repo dotfiles-config optionnel)
;  2. Config locale non versionnée (fallback)
;
;  Pour les collègues : créer ~/.gitconfig.local depuis le template
;  Pour toi : utiliser dotfiles-config + ~/.gitconfig.local si besoin
; ============================================================
[include]
	; Config privée versionnée (optionnel)
	path = ~/.projects/dotfiles-config/gitconfig.local
	; Config locale non versionnée (fallback/override)
	path = ~/.gitconfig.local
