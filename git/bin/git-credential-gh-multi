#!/bin/sh
# Git credential helper : sert le jeton gh du compte associé au propriétaire du dépôt,
# sans jamais lancer gh auth switch. Échoue vite avec quit=1 : ni fenêtre, ni invite.
#
# Générique : aucun compte ici. Le mapping (<propriétaire> <compte>, un par ligne) est un
# fichier personnel, désigné par ghmulti.accountMap. Config à poser dans gitconfig.local
# (dotfiles-config ou ~/.gitconfig.local), jamais dans le .gitconfig partagé :
#
#   [ghmulti]
#       accountMap = ~/chemin/vers/github-accounts.conf
#   [credential "https://github.com"]
#       helper =                                   ; vide la liste : plus de GCM
#       helper = "!\"$HOME\"/.config/git/bin/git-credential-gh-multi"
#       helper = "!f() { echo quit=1; }; f"        ; bouchon si le helper est introuvable
#       useHttpPath = true                         ; sinon git n'envoie pas le propriétaire
#
# Le bouchon passe par une fonction : git ajoute l'action (get) à la commande, et
# "!echo quit=1" afficherait "quit=1 get", que git rejette comme booléen invalide.
#
# Usage interne : git-credential-gh-multi resolve <propriétaire>  -> affiche le compte gh.
# GH_ACCOUNT_MAP remplace ghmulti.accountMap (tests).

map="${GH_ACCOUNT_MAP:-$(git config --type=path --get ghmulti.accountMap 2>/dev/null)}"

fail() {
    echo "git-credential-gh-multi: $*" >&2
    echo "quit=1"
    exit 1
}

# Affiche le compte gh associé au propriétaire $1 (sans casse), jamais de compte par défaut.
# Code 2 : map absente ou illisible. Code 1 : propriétaire absent ou en double.
resolve_account() {
    [ -n "$map" ] && [ -r "$map" ] || return 2
    awk -v owner="$1" '
        { sub(/\r$/, "") }
        /^[[:space:]]*(#|$)/ { next }
        tolower($1) == tolower(owner) { n++; account = $2 }
        END { if (n != 1 || account == "") exit 1; print account }
    ' "$map"
}

# Message d'échec de resolve_account selon son code.
resolve_error() {
    if [ "$1" -eq 2 ]; then
        echo "map illisible : '${map:-ghmulti.accountMap non défini}'"
    else
        echo "propriétaire '$2' absent ou en double dans $map"
    fi
}

case "$1" in
    resolve)
        account=$(resolve_account "$2") || { rc=$?; echo "git-credential-gh-multi: $(resolve_error $rc "$2")" >&2; exit 1; }
        echo "$account"
        exit 0 ;;
    get) ;;
    *) exit 0 ;;   # store / erase : rien à mémoriser, gh garde le jeton.
esac

protocol= host= path=
while IFS='=' read -r key value; do
    [ -z "$key" ] && break
    case "$key" in
        protocol) protocol=$value ;;
        host) host=$value ;;
        path) path=$value ;;
    esac
done

# Pas notre requête (autre hôte, ou http en clair) : sortie muette.
[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0
case "$path" in *..*|*%*) fail "path refusé (.. ou encodage %) : $path" ;; esac
owner=${path%%/*}
[ -n "$owner" ] || fail "requête sans path : poser credential.https://github.com.useHttpPath=true"
account=$(resolve_account "$owner") || fail "$(resolve_error $? "$owner")"
# --hostname : sans lui, un GH_HOST hérité ferait lire le jeton d'un autre hôte.
token=$(gh auth token --hostname github.com --user "$account" 2>/dev/null) || fail "aucun jeton gh pour le compte '$account' (gh auth status)"
[ -n "$token" ] || fail "jeton vide pour le compte '$account'"

printf 'username=%s\npassword=%s\n' "$account" "$token"
